# Public origin of the site (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: live YouTube subscriber/video counts (YouTube Data API v3).
# Without it the static numbers in src/data/site.ts are used.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# Secret for POST /api/revalidate (on-demand cache invalidation)
REVALIDATE_SECRET=
