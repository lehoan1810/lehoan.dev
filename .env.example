# Public origin of the site (canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: GitHub token (read-only, no scopes needed for public data).
# Enables the contribution heatmap and raises the API rate limit.
# Without it the page shows the language mix instead of the heatmap.
GITHUB_TOKEN=

# Secret for POST /api/revalidate?tag=github (on-demand cache invalidation)
REVALIDATE_SECRET=
